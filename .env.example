# --- Supabase ---------------------------------------------------------------
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Project settings → Database → Connection string.
# Runtime MUST use the transaction pooler (port 6543) — the session pooler's
# client cap gets exhausted by serverless functions (EMAXCONNSESSION).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# drizzle-kit migrations use the session pooler (port 5432); optional locally,
# falls back to DATABASE_URL (CI uses plain Postgres for both).
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Agent (Phase 2) --------------------------------------------------------
# ANTHROPIC_API_KEY=
# AGENT_DRAIN_SECRET=<random-string, protects POST /api/agent/drain>

# --- Google sync (Phase 5) --------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_ENCRYPTION_KEY=<32-byte hex, encrypts stored refresh tokens>
